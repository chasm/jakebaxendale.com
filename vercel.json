{
	"cleanUrls": true,
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Sitebender",
					"value": "jakebaxendale.com"
				},
				{
					"key": "Content-Security-Policy",
					"value": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; style-src 'unsafe-inline' 'self'; script-src 'self'; img-src 'self'; frame-src https://www.youtube.com https://player.twitch.tv https://bandcamp.com;"
				},
				{
					"key": "Strict-Transport-Security",
					"value": "max-age=31536000; includeSubDomains; preload"
				},
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "X-Frame-Options",
					"value": "DENY"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				}
			]
		},
		{
			"source": "/images/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "max-age=172800, must-revalidate"
				}
			]
		}
	],
	"redirects": []
}
